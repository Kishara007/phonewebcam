---
import type { BreadcrumbItem } from '@/lib/seo';

interface Props {
  items: readonly BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex flex-wrap items-center gap-2 text-sm sm:text-base font-semibold text-muted">
    {
      items.map((item, idx) => {
        const isLast = idx === items.length - 1;
        return (
          <li class="inline-flex items-center gap-2">
            {idx > 0 && (
              <span aria-hidden="true" class="text-muted/60 select-none">
                /
              </span>
            )}
            {item.href && !isLast ? (
              <a
                href={item.href}
                class="text-muted hover:text-ink hover:underline transition"
              >
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="text-ink font-bold">
                {item.label}
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
