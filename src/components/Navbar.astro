---
import { LANGUAGES } from '@/i18n';
import en from '@/i18n/en.json';
---

<header
  data-chrome
  class="sticky top-0 z-40 w-full backdrop-blur-xl bg-primary/80 border-b border-edge/50"
>
  <nav
    aria-label="Primary Navigation"
    class="max-w-5xl mx-auto px-3 sm:px-6 h-14 lg:h-16 flex items-center justify-between gap-1.5 sm:gap-2"
  >
    <!-- Brand Logo (Icon-only on mobile/tablet, Icon + Name on Desktop) -->
    <a
      href="/"
      class="inline-flex items-center gap-2.5 shrink-0 group rounded-xl py-1 pr-1"
      aria-label={en['nav.home']}
      data-i18n-aria="nav.home"
      title="PhoneWebcam"
    >
      <span
        class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-accent flex items-center justify-center text-[#0F172A] shadow-sm group-hover:bg-accent-hover transition"
      >
        <svg
          width="20"
          height="20"
          class="w-[18px] h-[18px] sm:w-5 sm:h-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5" />
          <rect x="2" y="6" width="14" height="12" rx="2.5" />
          <circle cx="9" cy="12" r="2.2" />
        </svg>
      </span>
      <span class="hidden lg:inline text-lg font-extrabold tracking-tight text-ink">
        PhoneWebcam
      </span>
    </a>

    <!-- Right-side Navigation Controls -->
    <div class="flex items-center gap-1 sm:gap-1.5 lg:gap-2">
      <!-- How to Use / Guide -->
      <a
        href="/how-to-use"
        class="inline-flex items-center justify-center gap-1.5 w-8 h-8 sm:w-9 sm:h-9 lg:w-auto lg:h-9 lg:px-3 rounded-xl text-muted hover:text-ink hover:bg-card/80 font-semibold text-sm transition"
        aria-label={en['nav.howToUse']}
        title={en['nav.howToUse']}
        data-i18n-aria="nav.howToUse"
        data-i18n-title="nav.howToUse"
      >
        <svg
          width="18"
          height="18"
          class="w-[18px] h-[18px] lg:hidden shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
        </svg>
        <span class="hidden lg:inline" data-i18n="nav.howToUse">{en['nav.howToUse']}</span>
      </a>

      <!-- Hire Me -->
      <a
        href="/hire-me"
        class="inline-flex items-center justify-center gap-1.5 w-8 h-8 sm:w-9 sm:h-9 lg:w-auto lg:h-9 lg:px-3 rounded-xl text-muted hover:text-ink hover:bg-card/80 font-semibold text-sm transition"
        aria-label={en['nav.hireMe']}
        title={en['nav.hireMe']}
        data-i18n-aria="nav.hireMe"
        data-i18n-title="nav.hireMe"
      >
        <svg
          width="18"
          height="18"
          class="w-[18px] h-[18px] lg:hidden shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2" y="7" width="20" height="14" rx="2" />
          <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
        </svg>
        <span class="hidden lg:inline" data-i18n="nav.hireMe">{en['nav.hireMe']}</span>
      </a>

      <!-- Support the Developer (Gumroad Coffee) -->
      <a
        href="https://kisharadilshan.gumroad.com/coffee"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-accent inline-flex items-center justify-center gap-2 w-8 h-8 sm:w-9 sm:h-9 lg:w-auto lg:h-9 lg:px-3.5 rounded-xl font-bold text-sm"
        aria-label={en['nav.support']}
        title={en['nav.support']}
        data-i18n-aria="nav.support"
        data-i18n-title="nav.support"
      >
        <svg
          width="17"
          height="17"
          class="w-[17px] h-[17px] shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.1"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M10 2v2" />
          <path d="M14 2v2" />
          <path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1" />
          <path d="M6 2v2" />
        </svg>
        <span class="hidden lg:inline whitespace-nowrap" data-i18n="nav.support">
          {en['nav.support']}
        </span>
      </a>

      <span class="hidden lg:block w-px h-5 bg-edge/70 mx-0.5" aria-hidden="true"></span>

      <!-- GitHub Icon-Only Link -->
      <a
        href="https://github.com/Kishara007/phonewebcam"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary inline-flex items-center justify-center w-8 h-8 sm:w-9 sm:h-9 rounded-xl text-ink"
        aria-label={en['nav.github']}
        title={en['nav.github']}
        data-i18n-aria="nav.github"
        data-i18n-title="nav.github"
      >
        <svg
          width="18"
          height="18"
          class="w-[17px] h-[17px] sm:w-[18px] sm:h-[18px]"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12 .5C5.649.5.5 5.649.5 12c0 5.084 3.292 9.397 7.861 10.918.575.106.785-.25.785-.555 0-.273-.01-1-.015-1.963-3.198.695-3.873-1.541-3.873-1.541-.523-1.328-1.277-1.682-1.277-1.682-1.044-.714.079-.7.079-.7 1.154.081 1.762 1.185 1.762 1.185 1.026 1.758 2.692 1.25 3.348.956.104-.743.402-1.25.731-1.538-2.553-.29-5.237-1.276-5.237-5.68 0-1.255.448-2.28 1.184-3.084-.119-.291-.513-1.46.112-3.043 0 0 .966-.309 3.164 1.178a10.99 10.99 0 0 1 2.88-.387c.977.005 1.962.132 2.881.387 2.196-1.487 3.16-1.178 3.16-1.178.627 1.583.233 2.752.114 3.043.738.804 1.183 1.829 1.183 3.084 0 4.415-2.688 5.387-5.249 5.672.413.356.781 1.058.781 2.132 0 1.539-.014 2.78-.014 3.158 0 .308.207.667.791.554C20.213 21.392 23.5 17.081 23.5 12 23.5 5.649 18.351.5 12 .5Z" />
        </svg>
      </a>

      <!-- Language Selector Dropdown (8 Languages) -->
      <div class="relative" id="lang-menu-root">
        <button
          id="lang-menu-button"
          type="button"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-label={en['nav.language']}
          title={en['nav.language']}
          data-i18n-aria="nav.language"
          data-i18n-title="nav.language"
          class="btn-secondary inline-flex items-center justify-center gap-1.5 w-8 h-8 sm:w-9 sm:h-9 lg:w-auto lg:px-2.5 rounded-xl text-ink font-bold text-xs"
        >
          <svg
            width="17"
            height="17"
            class="w-[17px] h-[17px] shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" />
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
            <path d="M2 12h20" />
          </svg>
          <span id="lang-current-code" class="hidden lg:inline font-mono text-xs font-extrabold">
            EN
          </span>
          <svg
            width="12"
            height="12"
            class="hidden lg:block w-3 h-3 opacity-65"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </button>

        <div
          id="lang-menu-dropdown"
          role="listbox"
          aria-label={en['nav.language']}
          class="hidden absolute right-0 mt-2 w-44 py-1.5 rounded-2xl bg-card border border-edge shadow-xl z-50"
        >
          {
            LANGUAGES.map((lang) => (
              <button
                type="button"
                role="option"
                data-lang-option={lang.code}
                aria-selected={lang.code === 'en' ? 'true' : 'false'}
                class="w-full px-3.5 py-2 text-left flex items-center justify-between text-sm font-semibold text-ink hover:bg-surface/60 transition"
              >
                <span>{lang.label}</span>
                <span class="font-mono text-xs text-muted">{lang.short}</span>
              </button>
            ))
          }
        </div>
      </div>

      <!-- Light / Dark Mode Toggle -->
      <button
        id="theme-toggle-button"
        type="button"
        aria-label={en['nav.themeToggle']}
        title={en['nav.themeToggle']}
        data-i18n-aria="nav.themeToggle"
        data-i18n-title="nav.themeToggle"
        class="btn-secondary inline-flex items-center justify-center w-8 h-8 sm:w-9 sm:h-9 rounded-xl text-ink"
      >
        <!-- Moon Icon (shown in Light mode -> click to go Dark) -->
        <svg
          width="18"
          height="18"
          class="w-[18px] h-[18px] block dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
        <!-- Sun Icon (shown in Dark mode -> click to go Light) -->
        <svg
          width="18"
          height="18"
          class="w-[18px] h-[18px] hidden dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2" />
          <path d="M12 20v2" />
          <path d="m4.93 4.93 1.41 1.41" />
          <path d="m17.66 17.66 1.41 1.41" />
          <path d="M2 12h2" />
          <path d="M20 12h2" />
          <path d="m6.34 17.66-1.41 1.41" />
          <path d="m19.07 4.93-1.41 1.41" />
        </svg>
      </button>
    </div>
  </nav>
</header>
