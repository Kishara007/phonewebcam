---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import {
  buildBreadcrumbSchema,
  buildPersonSchema,
  type BreadcrumbItem,
} from '@/lib/seo';

const PAGE_TITLE = 'Hire Kishara Dilshan — Astro, React & Web Tool Developer';
const PAGE_DESC =
  'Need a fast, SEO-optimized web app or client-side WASM tool? Hire Kishara Dilshan, creator of PhoneWebcam, for custom Astro, React & Next.js builds.';

const breadcrumbs: BreadcrumbItem[] = [
  { label: 'Home', href: '/' },
  { label: 'Hire Me', href: '/hire-me' },
];

const specialties = [
  {
    title: 'Ultra-fast, SEO-optimized web applications',
    description:
      'Astro, React, Next.js — engineered for sub-second loads, technical SEO, and clean scalability.',
  },
  {
    title: 'Client-side processing & WebAssembly (WASM) tools',
    description:
      'Zero-server media, PDF, and data utilities that run privately inside the browser.',
  },
  {
    title: 'UI/UX design & High-converting landing pages',
    description:
      'Minimal, accessible interfaces crafted to convert visitors effortlessly across desktop and mobile.',
  },
];

const schemas = [
  buildBreadcrumbSchema(breadcrumbs),
  buildPersonSchema(),
];
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  canonicalPath="/hire-me"
  ogType="profile"
  schemas={schemas}
>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <Breadcrumbs items={breadcrumbs} />

    <section class="rounded-3xl bg-card border-2 border-edge p-6 sm:p-10 tool-card-shadow space-y-8">
      <!-- Availability Badge & Headline -->
      <header class="space-y-4">
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-emerald-500/15 border border-emerald-500/35 text-emerald-800 dark:text-emerald-300 text-sm font-bold">
          <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
          </span>
          <span>Available for Freelance Projects</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-ink leading-tight">
          Need a Custom IT Solution?
        </h1>

        <p class="text-lg sm:text-xl text-muted leading-relaxed">
          Hi, I'm <strong class="text-ink">Kishara Dilshan</strong>, the developer behind PhoneWebcam. If you love this fast, client-side tool and need a world-class IT solution for your own business, I am available for freelance projects. I specialize in:
        </p>
      </header>

      <!-- Specialties -->
      <div class="grid grid-cols-1 gap-4">
        {
          specialties.map((item, idx) => (
            <div class="p-5 sm:p-6 rounded-2xl bg-surface/70 border border-edge flex items-start gap-4">
              <div
                aria-hidden="true"
                class="w-10 h-10 rounded-xl bg-accent text-[#0F172A] font-mono font-extrabold text-lg flex items-center justify-center shrink-0 mt-0.5"
              >
                0{idx + 1}
              </div>
              <div class="space-y-1">
                <h2 class="text-lg sm:text-xl font-extrabold text-ink">
                  {item.title}
                </h2>
                <p class="text-base text-muted leading-relaxed">
                  {item.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Direct Email CTA + Copy Email Button -->
      <div class="rounded-2xl bg-surface border-2 border-edge p-6 sm:p-7 space-y-5">
        <div class="space-y-1.5">
          <p class="text-xl sm:text-2xl font-extrabold text-ink">
            Let's build something amazing together.
          </p>
          <p class="text-base text-muted font-medium">
            Email me directly:{' '}
            <a
              href="mailto:kisharadilshan007@gmail.com"
              class="font-bold text-ink underline decoration-accent decoration-2 underline-offset-2 break-all"
            >
              kisharadilshan007@gmail.com
            </a>
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <a
            href="mailto:kisharadilshan007@gmail.com"
            class="btn-accent flex-1 inline-flex items-center justify-center gap-2.5 min-h-[54px] px-5 py-3 rounded-2xl font-extrabold text-base sm:text-lg shadow-sm"
          >
            <span>📩 kisharadilshan007@gmail.com</span>
          </a>

          <button
            id="copy-email-btn"
            type="button"
            data-email="kisharadilshan007@gmail.com"
            class="inline-flex items-center justify-center gap-2 min-h-[54px] px-5 py-3 rounded-2xl bg-card hover:bg-edge/50 border-2 border-edge text-ink font-extrabold text-base transition shrink-0"
          >
            <svg
              id="copy-email-icon"
              width="20"
              height="20"
              class="w-5 h-5 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="9" y="9" width="13" height="13" rx="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <svg
              id="copied-email-icon"
              width="20"
              height="20"
              class="w-5 h-5 shrink-0 hidden text-emerald-600 dark:text-emerald-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
            <span id="copy-email-label">Copy Email</span>
          </button>
        </div>

        <p
          id="copy-email-status"
          role="status"
          aria-live="polite"
          class="min-h-[1.5rem] text-sm font-semibold text-emerald-700 dark:text-emerald-300 transition-opacity duration-200 opacity-0"
        ></p>
      </div>

      <!-- Secondary Links -->
      <div class="pt-2 border-t border-edge flex flex-wrap items-center justify-between gap-3">
        <a
          href="/"
          class="inline-flex items-center gap-2 font-bold text-ink hover:underline text-base"
        >
          <span>← Back to PhoneWebcam Tool</span>
        </a>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href="https://github.com/Kishara007"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 rounded-xl bg-surface hover:bg-edge/60 border border-edge text-ink font-bold text-sm transition"
          >
            GitHub Profile
          </a>
          <a
            href="https://kisharadilshan.gumroad.com/coffee"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 rounded-xl bg-surface hover:bg-edge/60 border border-edge text-ink font-bold text-sm transition"
          >
            Support the Developer
          </a>
        </div>
      </div>
    </section>
  </article>

  <script>
    const btn = document.getElementById('copy-email-btn');
    const label = document.getElementById('copy-email-label');
    const copyIcon = document.getElementById('copy-email-icon');
    const checkIcon = document.getElementById('copied-email-icon');
    const liveStatus = document.getElementById('copy-email-status');

    if (btn && label && copyIcon && checkIcon && liveStatus) {
      let resetTimer: number | null = null;

      btn.addEventListener('click', async () => {
        const email = btn.getAttribute('data-email') || 'kisharadilshan007@gmail.com';
        try {
          await navigator.clipboard.writeText(email);
        } catch {
          const temp = document.createElement('input');
          temp.value = email;
          document.body.appendChild(temp);
          temp.select();
          document.execCommand('copy');
          document.body.removeChild(temp);
        }

        label.textContent = 'Copied!';
        copyIcon.classList.add('hidden');
        checkIcon.classList.remove('hidden');
        liveStatus.textContent = `Copied ${email} to clipboard!`;
        liveStatus.classList.remove('opacity-0');
        liveStatus.classList.add('opacity-100');

        if (resetTimer !== null) {
          window.clearTimeout(resetTimer);
        }
        resetTimer = window.setTimeout(() => {
          label.textContent = 'Copy Email';
          checkIcon.classList.add('hidden');
          copyIcon.classList.remove('hidden');
          liveStatus.classList.remove('opacity-100');
          liveStatus.classList.add('opacity-0');
          liveStatus.textContent = '';
        }, 2500);
      });
    }
  </script>
</BaseLayout>
