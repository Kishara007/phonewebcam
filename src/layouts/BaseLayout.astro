---
import '@/styles/global.css';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import SEOHead from '@/components/SEOHead.astro';
import en from '@/i18n/en.json';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article' | 'profile';
  schemas?: Array<Record<string, unknown>>;
  pageId?: string;
}

const {
  title = en['meta.title'],
  description = en['meta.description'],
  canonicalPath = '/',
  ogType = 'website',
  schemas = [],
  pageId = 'page',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light" data-i18n-page={pageId}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <SEOHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogType={ogType}
      schemas={schemas}
    />

    <!-- Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Anti-FOUT Theme, Language & Instant OBS Clean View Boot Script -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var savedTheme = localStorage.getItem('phonewebcam-theme');
          var theme = savedTheme === 'dark' ? 'dark' : 'light';
          root.classList.toggle('dark', theme === 'dark');
          root.setAttribute('data-theme', theme);
          var metaTheme = document.querySelector('meta[name="theme-color"]');
          if (metaTheme) {
            metaTheme.setAttribute('content', theme === 'dark' ? '#0B161A' : '#71C9CE');
          }
        } catch (e) {
          root.classList.remove('dark');
          root.setAttribute('data-theme', 'light');
        }

        try {
          var params = new URLSearchParams(window.location.search);
          var view = params.get('view');
          if (view && /^[A-Za-z0-9]{4}$/.test(view.trim())) {
            root.classList.add('obs-clean-view');
          }
        } catch (e) {}

        try {
          var savedLang = localStorage.getItem('phonewebcam-lang');
          var allowed = ['en', 'es', 'pt', 'de', 'fr', 'ja', 'zh', 'ru'];
          if (savedLang && allowed.indexOf(savedLang) !== -1) {
            root.lang = savedLang;
          }
        } catch (e) {}
      })();
    </script>

    <!-- Google Tag Manager (GTM-MLWNP7WS) & Google Analytics 4 (G-NC04Z574BJ) — Async Non-Blocking -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-MLWNP7WS"></script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-NC04Z574BJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      var pwcIsObsClean = false;
      try {
        pwcIsObsClean = new URLSearchParams(window.location.search).has('view');
      } catch (e) {}
      if (!pwcIsObsClean) {
        gtag('config', 'G-NC04Z574BJ');
      }
    </script>
  </head>

  <body class="min-h-screen flex flex-col bg-primary text-ink antialiased selection:bg-accent/40 selection:text-ink">
    <Navbar />
    <main class="flex-1 w-full">
      <slot />
    </main>
    <Footer />

    <script>
      import {
        LANGUAGES,
        applyTranslationsToDom,
        getStoredLang,
        isValidLang,
        setAppLanguage,
        type LanguageCode,
      } from '@/i18n';

      const THEME_STORAGE_KEY = 'phonewebcam-theme';

      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle-button');
        if (!btn) return;

        btn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.contains('dark');
          const nextTheme = isDark ? 'light' : 'dark';
          document.documentElement.classList.toggle('dark', nextTheme === 'dark');
          document.documentElement.setAttribute('data-theme', nextTheme);

          const metaTheme = document.querySelector('meta[name="theme-color"]');
          if (metaTheme) {
            metaTheme.setAttribute('content', nextTheme === 'dark' ? '#0B161A' : '#71C9CE');
          }

          try {
            localStorage.setItem(THEME_STORAGE_KEY, nextTheme);
          } catch {
            // Ignore storage restrictions
          }
        });
      }

      function initLanguageSwitcher() {
        const root = document.getElementById('lang-menu-root');
        const btn = document.getElementById('lang-menu-button');
        const dropdown = document.getElementById('lang-menu-dropdown');
        const currentCodeEl = document.getElementById('lang-current-code');

        const syncUi = (lang: LanguageCode) => {
          const info = LANGUAGES.find((l) => l.code === lang) ?? LANGUAGES[0];
          if (currentCodeEl) currentCodeEl.textContent = info.short;

          dropdown?.querySelectorAll<HTMLButtonElement>('[data-lang-option]').forEach((opt) => {
            const selected = opt.dataset.langOption === lang;
            opt.setAttribute('aria-selected', selected ? 'true' : 'false');
            opt.classList.toggle('bg-surface', selected);
          });
        };

        // Apply saved language immediately on load
        const initialLang = getStoredLang();
        applyTranslationsToDom(initialLang);
        syncUi(initialLang);

        if (!root || !btn || !dropdown) return;

        const closeMenu = () => {
          dropdown.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
        };

        const toggleMenu = () => {
          const willOpen = dropdown.classList.contains('hidden');
          dropdown.classList.toggle('hidden', !willOpen);
          btn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
        };

        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleMenu();
        });

        dropdown.querySelectorAll<HTMLButtonElement>('[data-lang-option]').forEach((option) => {
          option.addEventListener('click', () => {
            const code = option.dataset.langOption;
            if (isValidLang(code)) {
              setAppLanguage(code);
              syncUi(code);
            }
            closeMenu();
          });
        });

        document.addEventListener('click', (e) => {
          if (!root.contains(e.target as Node)) {
            closeMenu();
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            closeMenu();
          }
        });
      }

      initThemeToggle();
      initLanguageSwitcher();
    </script>
  </body>
</html>
